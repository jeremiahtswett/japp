# Copy this file to .env (japp init does this) and fill in your own keys.
# .env is gitignored — never commit it.

# --- Anthropic API (used for LLM relevance scoring) ---
# Get a key at https://console.anthropic.com/ -> API Keys.
ANTHROPIC_API_KEY=

# --- Email notifications (immediate alerts + daily digest) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASSWORD=an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO_EMAIL=

# --- Reply-by-email tailoring (japp inbox) ---
# All optional for Gmail: the same account + app password used for SMTP above
# also serves IMAP, and replies are only accepted from DIGEST_TO_EMAIL.
# Set these only if your inbox lives elsewhere or a different person approves.
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#IMAP_USER=
#IMAP_PASSWORD=
#INBOX_APPROVED_SENDER=

# --- Adzuna (optional broad-market discovery; sources.yaml adzuna.enabled) ---
# Register free at https://developer.adzuna.com/ to get both values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
